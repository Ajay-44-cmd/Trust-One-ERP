# ============================================
# Trust One ERP — Environment Variables
# ============================================
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to GitHub.

# --- Backend Core ---
PROJECT_NAME="College ERP System"
API_V1_STR="/api/v1"

# JWT Secret Key (minimum 32 characters, keep private!)
SECRET_KEY="CHANGE_ME_to_a_random_secret_min_32_chars"

# JWT Algorithm
ALGORITHM="HS256"

# Token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database ---
# Supabase PostgreSQL (or any Postgres connection string)
# Leave blank or omit to use local SQLite fallback automatically
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# --- CORS Origins ---
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","*"]

# --- SMS Provider (optional) ---
# Options: SIMULATOR (default), TWILIO, MSG91
SMS_PROVIDER="SIMULATOR"

# Twilio (only if SMS_PROVIDER=TWILIO)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# MSG91 (only if SMS_PROVIDER=MSG91)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="TRSTNE"
MSG91_DLT_TE_ID=""

